# --- Server-side (recommended) ---------------------------------------------
# Used by the Netlify proxy function (and by `npm run dev` / `npm run preview`,
# which run the same function locally). Never exposed to the browser.
TMDB_API_KEY=YOUR_TMDB_API_KEY
# Optional alternative: TMDB v4 read access token
# TMDB_READ_TOKEN=

# --- Client-side ---------------------------------------------------------------
# Route requests through the proxy first (default: true)
VITE_USE_TMDB_PROXY=true

# Optional backup key for direct browser calls (automatic failover between
# api.themoviedb.org and api.tmdb.org). Visible in the bundle — leave empty in
# production when the proxy is configured.
VITE_TMDB_API_KEY=
